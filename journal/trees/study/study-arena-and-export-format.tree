\p{The nightly already accepts the eta family (\code{\verb~|eta-ctor~}, \code{\verb~|eta-struct-major-*~}, \code{\verb~|eta-unit-like-*~}) and rejects \code{\verb~|subject-reduction-redex~}; these tests may become \code{\verb~|accept~} when the arena's official checker and toolchain move on. Imitating O35 is safe today; the algorithm should leave room for the nightly's eta rules, in particular "eta-expand a structure major before whnf", which is the only way not to loop on the two \code{\verb~|no-whnf~} tests.}
}

\subtree{
\title{3.6 perf/ (37 accept, 8 reject)}

\p{Virtual seconds (instr/6e9); E = error, T = timeout. tenet-jvm's floor is ≈ 0.11 (JVM start-up).}

\table{
\tr{\th{test}\th{to}\th{official}\th{nano-lean}\th{gruszka}\th{tenet-jvm}\th{the algorithmic question}}
\tr{\td{app-lam}\td{70}\td{4.87}\td{0.01}\td{0.08}\td{11.70}\td{n levels of \code{\verb~|c (λ…) (λ…)~} with shared arguments, depth 19,999: infer cache on shared subterms (else 2ⁿ) and no O(n) substitution per binder (else n²)}}
\tr{\td{args-before-unfold}\td{40}\td{0.04}\td{0.00}\td{0.00}\td{0.26}\td{\code{\verb~|count #n~} vs \code{\verb~|count (N.add #(n-1) #1)~}: compare arguments of an equal head before unfolding (Θ(n) vs Θ(n²))}}
\tr{\td{beta-ladder}\td{40}\td{1.67}\td{0.00}\td{0.04}\td{2.23}\td{2000 nested β-redexes over one body: environment machine Θ(n) vs substitution Θ(n²)}}
\tr{\td{church-numerals}\td{40}\td{0.05}\td{0.00}\td{0.01}\td{0.33}\td{\code{\verb~|cmul (cnum n) (cnum (n+1))~} both ways, 14,520 β steps under binders}}
\tr{\td{discarded-argument}\td{40}\td{0.17}\td{0.00}\td{0.00}\td{0.46}\td{\code{\verb~|dropArg (count #n)~} vs \code{\verb~|dropArg (count #(n+1))~}: unfold a head that ignores its argument before comparing arguments}}
\tr{\td{discarded-argument-match}\td{40}\td{0.15}\td{0.00}\td{0.00}\td{0.75}\td{same through \code{\verb~|brecOn~}/\code{\verb~|below~} tables that are built and never read}}
\tr{\td{folded-constant-first / -last}\td{40}\td{0.05 / 0.04}\td{0.00}\td{0.00}\td{0.28}\td{\code{\verb~|tagged (count #n)~} vs a pair: a constant unfolded for one component should not have to be re-evaluated for the other}}
\tr{\td{fueled-chain}\td{40}\td{0.13}\td{0.02}\td{0.01}\td{0.77}\td{monadic programs differing in the instance; proof irrelevance on \code{\verb~|Subtype~} proofs doubles the work per guard unless equal terms are recognised early (nanobruijn: 256 s at N = 12)}}
\tr{\td{gf3-matrix-product}\td{70}\td{1.82}\td{0.83}\td{2.44}\td{9.94}\td{781×781 GF(3) matrices as 609,961-bit \code{\verb~|Nat~} literals: bignum shift/and/mul/xor speed; caches must not retain every intermediate (official 3.5 GiB); hash of big literals}}
\tr{\td{grind-ring-5}\td{50}\td{2.18}\td{0.22}\td{0.25}\td{4.13}\td{one large \code{\verb~|grind~} proof term (203 k lines)}}
\tr{\td{identical-nesting}\td{40}\td{0.03}\td{0.00}\td{0.00}\td{0.11}\td{identical terms \code{\verb~|f4 (f4 (…))~}: test syntactic/pointer equality before unfolding (else exponential)}}
\tr{\td{irrelevance-before-evaluation}\td{40}\td{0.03}\td{0.00}\td{0.00}\td{0.12}\td{\code{\verb~|slowTriv (count #n) = True.intro~}: proof irrelevance before reducing proofs}}
\tr{\td{irrelevance-refutes}\td{40}\td{0.03}\td{0.00}\td{0.00}\td{0.12}\td{proofs of non-defeq propositions are not defeq: take irrelevance's negative answer too instead of unfolding \code{\verb~|Nat.rec~} proofs}}
\tr{\td{ite-taken-branch}\td{230}\td{19.41}\td{0.04}\td{0.05}\td{17.88}\td{\code{\verb~|(if true = true then piA else tA)~} vs \code{\verb~|piA~}: unfold the cheap \code{\verb~|ite~}/\code{\verb~|Decidable~} side although the other constant is "higher"}}
\tr{\td{ite-taken-branch-bad (reject)}\td{110}\td{6.77}\td{0.27}\td{0.62}\td{7.86}\td{\code{\verb~|if false = true …~}: must decide the condition; refuting may evaluate \code{\verb~|piA~} (rpylean 27.6)}}
