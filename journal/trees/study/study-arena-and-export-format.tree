\tr{\td{\strong{nat-shift-huge (accept)}}\td{\code{\verb~|Nat.shiftRight 42 (2^64) = 0~}, \code{\verb~|Nat.shiftLeft 0 (2^64) = 0~}, closed and under \code{\verb~|Nat.rec~}}\td{shift counts ≥ 2⁶⁴ without overflow/OOM}\td{rpylean crashed; today: nano-lean declines (11 GB, budget), sokonanoda panics, tenet-jvm OOM after 366 s, 5 checkers reject}}
