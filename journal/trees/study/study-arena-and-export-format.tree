\tr{\td{nested-rec-rule-nfields}\td{\code{\verb~|nfields = 1~} instead of 2 in a rule of a nested inductive's recursor}\td{recompute nfields, also for nested}\td{nanoda (earlier); 4 checkers today}}
\tr{\td{nested-unused-param}\td{ill-typed argument \code{\verb~|b~} in a nested occurrence \code{\verb~|L (E w) b~} that disappears in the auxiliary type}\td{type-check nested applications' parameters ("invalid projection w.1")}\td{official (lean4\verb~|#~14576)}}
\tr{\td{open-term-cache-context}\td{shared open subterm \code{\verb~|#1 #0~} under binders of different types}\td{infer-cache for open terms must depend on the binder types ("application type mismatch f y")}\td{ocaml4lean branch}}
