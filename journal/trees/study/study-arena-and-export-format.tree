\tr{\td{loop-unfolded-once}\td{40}\td{0.52}\td{0.04}\td{0.04}\td{1.92}\td{\code{\verb~|allInK 0 N p~} vs its one-step unfolding, N = 10⁶: unfold once, do not run the loop}}
\tr{\td{loop-unfolded-once-bad (reject)}\td{120}\td{14.24}\td{0.04}\td{0.05}\td{2.79}\td{bodies differ under a binder; official refutes in ~N³}}
\tr{\td{magma-list-deep-n21 / n36}\td{70 / 360}\td{2.70 / 35.45}\td{0.05 / 0.42}\td{0.28 / 9.43}\td{4.99 / 57.76}\td{\code{\verb~|decide~} over finite magmas with \code{\verb~|List~} tables: raw evaluation throughput on deep closed computations (rpylean 0.05 / 0.20)}}
\tr{\td{magma-list-pair-n21 / n7}\td{240 / 60}\td{18.55 / 1.71}\td{2.23 / 0.20}\td{3.12 / 0.25}\td{19.07 / 2.58}\td{21⁴ ≈ 195 k tuples, list lookups (rpylean best: 1.11)}}
\tr{\td{magma-string-n4 / pair-n9}\td{70 / 120}\td{3.58 / 8.21}\td{0.23 / 0.49}\td{0.26 / 0.72}\td{4.89 / 14.64}\td{table stored in a \code{\verb~|String~}: literal decoding on every lookup (rpylean OOM at 14.65 GB on n9)}}
\tr{\td{proj-app-lazy-delta}\td{60}\td{2.08}\td{0.00}\td{0.00}\td{3.04}\td{\code{\verb~|small.1 a~} vs \code{\verb~|(big N).1 a~}: lazy δ on \em{applied} projections (lean4\verb~|#~16613)}}
\tr{\td{proj-applied-struct}\td{230}\td{14.03}\td{0.00}\td{0.00}\td{14.82}\td{\code{\verb~|(gC slowA c).fn x~} vs \code{\verb~|(gC' slowA c).fn x~}: unfold \code{\verb~|gC'~} instead of reducing the structure (2¹⁹ steps); palladium E}}
\tr{\td{proj-applied-struct-bad / -arg-bad (reject)}\td{130 / 120}\td{4.88 / 4.69}\td{0.88 / 2.65}\td{1.06}\td{12.93 / 5.34}\td{equal heads with different arguments / propositional-only equality must be refuted}}
\tr{\td{proj-cheap-struct}\td{40}\td{0.04}\td{0.00}\td{0.00}\td{0.22}\td{\code{\verb~|(S u).re~} vs \code{\verb~|(S ()).re~}: compare stuck projections by their structures' arguments; do not evaluate \code{\verb~|S~} (2¹⁷)}}
\tr{\td{proj-lazy-struct}\td{40}\td{0.04}\td{0.00}\td{0.00}\td{0.17}\td{\code{\verb~|(P a).1~} vs \code{\verb~|(Q b).1~}: project as soon as both are constructors; do not compare whole structures}}
\tr{\td{proj-stuck-struct}\td{40}\td{0.04}\td{0.00}\td{0.00}\td{0.17}\td{keep the unreduced structure argument of a stuck projection (else exponential unrolling)}}
\tr{\td{prop-struct-projections}\td{40}\td{0.10}\td{0.01}\td{0.01}\td{0.63}\td{200-field \code{\verb~|Prop~} structure: "is field j used later" must be O(1) per field (N² not N³)}}
\tr{\td{refute-cheap-first / -last (reject)}\td{40}\td{0.04 / 0.18}\td{0.00}\td{0.00}\td{0.13 / 0.63}\td{\code{\verb~|(false, count #n) = (true, count #(n+1))~} and swapped: order of comparing constructor arguments}}
\tr{\td{repeated-subproblem}\td{40}\td{0.03}\td{0.00}\td{0.00}\td{0.12}\td{perfect trees: memoise proved-equal pairs (n vs 2ⁿ)}}
\tr{\td{shared-subterm}\td{40}\td{0.06}\td{0.00}\td{0.01}\td{0.37}\td{consume a shared tree through its DAG, never expand 2ⁿ nodes}}
\tr{\td{shift-cascade}\td{40}\td{0.05}\td{0.00}\td{0.00}\td{0.28}\td{1000 nested \code{\verb~|let~}s capturing a λ parameter: no accumulation of deferred shifts}}
\tr{\td{short-circuit-and}\td{220}\td{17.50}\td{0.04}\td{0.04}\td{16.71}\td{\code{\verb~|false && A~} vs \code{\verb~|false && B~} with open, unequal A, B: unfold \code{\verb~|&&~} before comparing arguments (pestka 3.06)}}
\tr{\td{short-circuit-and-bad (reject)}\td{120}\td{6.18}\td{0.18}\td{0.65}\td{6.69}\td{\code{\verb~|true && …~}: must compare the arguments}}
\tr{\td{unfold-before-literal}\td{240}\td{14.47}\td{2.65}\td{0.01}\td{22.49}\td{\code{\verb~|[slowA, 1].sum~} vs \code{\verb~|slowA + (1 + 0)~}: δ-unfold before Nat-literal folding forces \code{\verb~|slowA~} (2¹⁹)}}
\tr{\td{unfold-before-literal-bad (reject)}\td{130}\td{4.87}\td{0.88}\td{1.06}\td{12.91}\td{\code{\verb~|… = slowA + (2 + 0)~}: failure of the shortcut must not be a "no" by itself, nor a "yes"}}
\tr{\td{unfold-before-literal-fallback}\td{270}\td{14.52}\td{2.65}\td{3.60}\td{22.31}\td{\code{\verb~|[slowA + 1, 1].sum = slowA + (2 + 0)~}: after the argument comparison fails, continue and accept (rpylean T, kefir 0.00)}}
\tr{\td{unroll-versus-evaluate}\td{40}\td{0.04}\td{0.00}\td{0.00}\td{0.16}\td{\code{\verb~|count #(n+1)~} vs \code{\verb~|N.add (count #n) #1~}: unfold the right one of two different heads}}
}

\p{Sources named in the descriptions: Courant & Leroy (POPL 2026) §2/§10, smalltt's \code{\verb~|conv_eval~}, AxiomMath/CFSG certificates, con-leche's own proofs, the SAIR equational-theories certificates.}
}
}

\subtree{
\title{4. results.json: failures, traps, policies}

\subtree{
\title{4.1 Everything the top 12 do not get right}

