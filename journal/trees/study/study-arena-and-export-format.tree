\tr{\td{level-imax-normalization}\td{\code{\verb~|imax 0 v~} vs \code{\verb~|succ (imax 0 v)~}}\td{normal form must keep the offset}\td{—}}
\tr{\td{loose-bvar-value}\td{definition value \code{\verb~|#0~} (loose), reached through an inductive that is checked first}\td{declaration roots must be closed; reject before unfolding ("type checker does not support loose bound variables")}\td{pestka hung; sokonanoda errors (exit 3) today}}
\tr{\td{nat-rec-k-lie}\td{\code{\verb~|Nat.rec~} marked \code{\verb~|k = true~}}\td{recompute \code{\verb~|k~}}\td{nanoda family (variant)}}
