\p{What the expensive declarations are:}

\table{
\tr{\th{corpus}\th{declaration(s)}\th{cost}\th{what makes it expensive}}
\tr{\td{cedar}\td{\code{\verb~|Cedar.Thm.checked_eval_entity_reachable._unary~}, \code{\verb~|level_based_no_dne_expr._unary~}, \code{\verb~|level_based_slicing_is_sound_expr._unary~}}\td{409M, 283M, 223M}\td{well-founded recursion proofs of 30-50 k nodes; 44-66 k infer misses, 51-88 k conversions driven by lazy delta (21-36 k iterations), 2-3 k reductions}}
\tr{\td{cedar}\td{\code{\verb~|Cedar.Spec.call.match_5.eq_23~} (6 private copies), \code{\verb~|Cedar.Validation.typeOfCall.match_1.eq_23~} (3), \code{\verb~|Cedar.Spec.apply₂.match_1.eq_18~} (3), \code{\verb~|compileApp₂.match_1.eq_18~} (3)}\td{260M, 143M, 112M, 120M each}\td{matcher equation lemmas (\code{\verb~|eq_18~}, \code{\verb~|eq_23~}: matches with at least that many alternatives): 5 k-node terms inferred under many contexts (66 k infer misses, 19 k conversions, 800 reductions); each is a \code{\verb~|_private~} copy per module, not shared by expression id}}
\tr{\td{cedar}\td{\code{\verb~|Cedar.Thm.Duration.parseDuration?_eq_duration?_of_wf~}, \code{\verb~|Cedar.Thm.Op.mkName.neq~}}\td{315M, 229M}\td{86 k and 61 k nodes; the second expands 2,112 string literals (12,672 characters) and fires 16 k derived rules}}
\tr{\td{cedar}\td{\code{\verb~|String.fromUTF8Lossy_surrogate_append._proof_1_10~} (Init)}\td{397M}\td{the only evaluation in cedar's top 50: a 65-node \code{\verb~|decide~} over \code{\verb~|UInt32~}/\code{\verb~|BitVec~}: 66 k rule firings, 8.5 k iota, 10.9 k Nat ops; 1.46x without derived rules}}
\tr{\td{cedar}\td{\code{\verb~|Array.extract_append._proof_1_1~}, \code{\verb~|Vector.extract_append._proof_1~} (Init)}\td{195M, 187M}\td{\code{\verb~|omega~} certificates: 19 k delta + 9 k iota on \code{\verb~|List.casesOn~}, \code{\verb~|List.zipWithAll~}, \code{\verb~|List.map._f~}, \code{\verb~|instDecidableEqList~} inside 24 k-node terms}}
\tr{\td{reachability}\td{\code{\verb~|Bench.Arena.{dag,path,grid}_reachable._proof_1~}, \code{\verb~|path_unreachable._proof_1~}, \code{\verb~|grid_shortest._proof_1~}}\td{3.55G, 2.63G, 1.24G, 2.53G, 141M}\td{\code{\verb~|decide~} on 19-96-node terms; the four large ones: 124-273 k rule firings, 128-361 k iota, 5-46 k Nat \code{\verb~|beq~}; hottest \code{\verb~|List.elem._f~} (166 k), \code{\verb~|Nat.decEq~}, \code{\verb~|instDecidableEqFin~}; 1.45-2.4x without derived rules}}
\tr{\td{con-leche}\td{\code{\verb~|ConLeche.Cached.reduceNatI._mutual.eq_def~}}\td{5.79G}\td{372,576-node unfolding lemma of a mutual well-founded definition: 1.14 M infer misses, 220 k conversions, 292 k \code{\verb~|PSum.casesOn~} unfoldings + 292 k \code{\verb~|PSum.rec~} iota in lazy delta}}
\tr{\td{con-leche}\td{\code{\verb~|ConLeche.Frontend.keyAt_eq~}, \code{\verb~|keyOf_105 .. keyOf_118~}}\td{331M, 165-172M each}\td{closed list and string computation inside 17-75 k-node proofs: 17 k delta, 9 k iota (\code{\verb~|List.filter.match_1~}, \code{\verb~|List.find?._f~}, \code{\verb~|Bool.casesOn~}), up to 130 string literal expansions each}}
\tr{\td{con-leche}\td{\code{\verb~|ConLeche.Model.Rules.{prop_pt_io,red_sound,defeq_sound,infer_sound}.match_2~}}\td{162-249M}\td{matchers of 9-32 k nodes with at most 9 reductions: pure inference (19-29 k misses) and conversion (9-13 k)}}
\tr{\td{NSE}\td{\code{\verb~|NavierStokes.{FiveProfileMoments,TerminalCompensation}.quadraticBilin._proof_{6,9}~}}\td{2.25G, 1.46G, 1.29G, 879M}\td{130-641 k-node proof terms over \code{\verb~|Matrix.vecCons~} vectors: 199-476 k infer misses, 88-237 k conversions, 15-39 k delta (\code{\verb~|Fin.induction~}, \code{\verb~|Nat.brecOn~}, \code{\verb~|Matrix.vecCons~})}}
\tr{\td{NSE}\td{\code{\verb~|EulerSourcePotentialCoefficient.potentialTimePath_translation~}}\td{141M}\td{366 nodes: 23.5 k unfoldings of instance projections (\code{\verb~|DFunLike.coe~} 5.1 k, \code{\verb~|AddHom.toFun~} 3.0 k) in lazy delta}}
\tr{\td{cslib}\td{Init's \code{\verb~|fromUTF8Lossy~} and \code{\verb~|extract_append~} proofs; own: \code{\verb~|Cslib.Automata.NA.loop_fin_run_exists._proof_*~}}\td{395M, 202M; 154M}\td{the corpus's top 10 are Init, Std and Mathlib declarations; Cslib's own most expensive proof is a 52 k-node term with 14 k reductions}}
\tr{\td{mathlib}\td{\code{\verb~|WeierstrassCurve.Affine.Point.sym2x_add_sub_eq_addSubMap_sym2x._proof_1_8~}}\td{1.19G}\td{\code{\verb~|decide~}-style evaluation on 4 k nodes: 159 k rule firings, 116 k iota, 30 k Nat ops; 2.5x without derived rules}}
}
}

