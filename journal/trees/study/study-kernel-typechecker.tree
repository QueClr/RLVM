\tr{\td{5}\td{\code{\verb~|is_prop~} throws when the sort is stuck; never "not Prop"}\td{\code{\verb~|:380~}}\td{\code{\verb~|bugs/proj-of-stuck-prop~}, \code{\verb~|proj-of-subst-prop~}, \code{\verb~|rec-of-subst-prop~}}\td{A}}
