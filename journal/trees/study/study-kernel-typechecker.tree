\tr{\td{2}\td{\code{\verb~|is_geq~} with imax: rhs imax needs both parts, lhs imax uses only its rhs, offsets compared last}\td{\code{\verb~|level.cpp:483-501~}}\td{\code{\verb~|bugs/level-imax-leq~}}\td{A}}
