\tr{\td{tutorial \code{\verb~|falseFromUnsafe~}, \code{\verb~|falseFromPartial~}}\td{theorem uses an unsafe / partial constant}\td{\verb~|#~3 then \verb~|#~12 (unknown constant)}}
\tr{\td{tutorial \code{\verb~|projOutOfRange~}, \code{\verb~|projNotStruct~}, \code{\verb~|projProp2/4/5/6~}, \code{\verb~|projIndexData*~}; \code{\verb~|bugs/proj-non-structure~}, \code{\verb~|proj-of-imax-prop~}, \code{\verb~|other/proj-of-prop~}}\td{invalid projection}\td{\verb~|#~13 with the rules of section 7 on regenerated records}}
\tr{\td{tutorial \code{\verb~|ruleKbad~}, \code{\verb~|ruleKAcc~}, \code{\verb~|accRecNoEta~}, \code{\verb~|indexedUnitEta~}, \code{\verb~|indexedStructEta~}; \code{\verb~|bugs/k-rec-conv~}}\td{def-eq must not use K / eta here}\td{\verb~|#~14 with regenerated \code{\verb~|k~}, \code{\verb~|numIndices~}, \code{\verb~|isRec~}}}
\tr{\td{\code{\verb~|bugs/proj-of-stuck-prop~}, \code{\verb~|proj-of-subst-prop~}, \code{\verb~|rec-of-subst-prop~}}\td{a sort that is stuck after substitution}\td{\code{\verb~|isProp~} must throw (4.2), 02 §6.10}}
\tr{\td{\code{\verb~|bugs/level-imax-leq~}, \code{\verb~|level-imax-normalization~}, \code{\verb~|closure-level-subst~}, \code{\verb~|pi-closure-context~}, \code{\verb~|open-term-cache-context~}, \code{\verb~|eta-ctor-alias~}, \code{\verb~|str-lit-utf8-bad~}, \code{\verb~|other/nat-lit-add-bad~}}\td{core type checker, not admission}\td{02}}
}

\p{"Either" tests touching admission and the official answer: \code{\verb~|corner-cases/large-elim-maybe-prop~} (official rejects: recursor differs), \code{\verb~|proof-param-swap~} (rejects, \verb~|#~30/\verb~|#~42), \code{\verb~|positivity-whnf~} (rejects, \verb~|#~41), \code{\verb~|vanishing-occurrence~} (accepts), \code{\verb~|nested-redex-aux~} (accepts, two auxiliary types), \code{\verb~|nested-nonuniform-param~} (rejects, \verb~|#~30), \code{\verb~|proj-maybe-prop*~} (accepts). \code{\verb~|corner-cases/proof-param-ok~} must be accepted.}
}

\subtree{
\title{11. Admission checklist, in execution order}

\p{Load time (per record):}

\ol{
\li{The line parses; every referenced name/level/expr index is already defined; no index is defined twice.}
\li{The declaration name is not already used by any earlier record of any kind (flat namespace).}
\li{Records flagged unsafe/partial are dropped (4.4); they are not admitted and not compared.}
}

\p{Every admitted constant (\code{\verb~|checkConstantVal~}):}

\<html:ol>[start]{4}{
\li{Name absent from the environment (this includes generated names such as \code{\verb~|I.rec~}, \code{\verb~|Quot.mk~}).}
\li{\code{\verb~|levelParams~} has no duplicates.}
\li{Type is closed (no loose bound variables; no fvar/mvar by construction).}
\li{Every universe parameter occurring in the type is in \code{\verb~|levelParams~}.}
\li{Every constant in the type is admitted and applied to as many levels as it has parameters.}
\li{The type type-checks.}
\li{The type of the type reduces to a sort.}
}

\p{Definition, theorem, opaque (after 4-10; axioms stop at 10):}

\<html:ol>[start]{11}{
\li{Value is closed.}
\li{Universe parameters and constants of the value satisfy 7 and 8.}
\li{Value type-checks, giving \code{\verb~|T'~}.}
\li{\code{\verb~|isDefEq(T', declared type)~}.}
\li{(definition) \code{\verb~|hints~} are stored verbatim and never trusted for correctness; \code{\verb~|all~} is ignored.}
\li{(theorem, before 11) \code{\verb~|isProp(type)~}: the type's sort level normalises to zero; a stuck sort is an error.}
\li{The constant becomes visible only after 4-16 (no self-reference).}
}

\p{Quot (first \code{\verb~|quot~} record):}

\<html:ol>[start]{18}{
\li{\code{\verb~|Eq~} is admitted and is an inductive type.}
\li{\code{\verb~|Eq~} has exactly one universe parameter and exactly one constructor.}
\li{\code{\verb~|Eq~}'s type is \code{\verb~|Pi(Sort u, Pi(#0, Pi(#1, Sort 0)))~}.}
\li{Its constructor's type is \code{\verb~|Pi(Sort u, Pi(#0, Eq.{u} #1 #0 #0))~}.}
\li{\code{\verb~|Quot~}, \code{\verb~|Quot.mk~}, \code{\verb~|Quot.lift~}, \code{\verb~|Quot.ind~} are absent.}
\li{Add the four canonical constants; set \code{\verb~|quotInit~} (enables quot reduction).}
\li{Every exported quot record is one of the four names with identical kind, \code{\verb~|levelParams~} and type.}
}

\p{Inductive item:}

\<html:ol>[start]{25}{
\li{Item consistency: nonempty; type records agree on \code{\verb~|levelParams~}, \code{\verb~|numParams~}, \code{\verb~|all~}; each \code{\verb~|ctors~} entry resolves to a ctor record of the item.}
\li{\code{\verb~|numParams~} fits a machine integer.}
\li{No constant or projection structure name with first component \code{\verb~|_nested~} in any type or ctor type.}
\li{\code{\verb~|levelParams~} has no duplicates.}
\li{(types and ctor types have no mvar/fvar - vacuous for exports.)}
\li{Uniform occurrences: every occurrence of a block type in a ctor type is applied to the block's levels and the ctor's parameter variables (6.2).}
\li{Nested elimination: first type and every ctor have at least \code{\verb~|numParams~} \em{syntactic} Pis; parameters of a nested container contain no local variables; container types strip their own parameters syntactically.}
\li{For each (auxiliary-block) type: \code{\verb~|I~} and \code{\verb~|I.rec~} absent.}
\li{Each type header type-checks under \code{\verb~|levelParams~} (closed, constants known, universes declared).}
\li{Header telescope: later types' parameter domains def-eq to the first type's; exactly \code{\verb~|numParams~} consumed.}
\li{Header ends (after \code{\verb~|whnf~}) in a sort.}
\li{All result sorts are \code{\verb~|is_equivalent~} to the first one.}
\li{Type names pairwise distinct; per type, ctor names distinct; each ctor name absent from the environment.}
\li{Each ctor type type-checks in the environment extended by the block's types.}
\li{Ctor parameter binder domains def-eq to the block parameters.}
\li{Each field's type is a type, and its universe is \code{\verb~|<=~} the result universe unless the result is a Prop.}
\li{Each field is strictly positive (after head normalisation); a recursive field ends in a valid \code{\verb~|I params idx~}.}
\li{Ctor result is syntactically \code{\verb~|I_k params idx~} with the block's levels, the parameter variables, the right arity and no block type inside the indices.}
\li{Ctor names absent when added (catches clashes across types and with type names).}
\li{Elimination universe (6.8).}
\li{K flag (6.9).}
\li{Recursor types and rules built; each recursor name absent when added (catches a ctor named \code{\verb~|rec~}).}
\li{Defensive: generated recursor types type-check and each rule preserves types.}
\li{Nested blocks: restore; every restored name absent; every nested application \code{\verb~|I Ds~} type-checks in the final environment (mandatory); restored ctor types, recursor types and rules type-check (defensive).}
\li{Every exported safe ctor record equals the generated constant of that name (all fields, type by \code{\verb~|==~}).}
\li{Every exported safe recursor record equals the generated constant of that name (all fields; type and rule right-hand sides by \code{\verb~|==~}; \code{\verb~|k~}; rule count and order).}
\li{An exported ctor/recursor name without a generated constant of the same kind is rejected.}
\li{Commit the generated constants (not the exported ones) to the environment.}
}

\p{End of file:}

\<html:ol>[start]{53}{
\li{No parked declaration remains (missing dependency = unknown constant).}
\li{Exit 0 only if every record passed; exit 1 on any failure; exit 2 only by explicit policy (section 8).}
}
}

\subtree{
\title{12. Not verified / open points}

\ul{
\li{Not read: the Mathlib export itself. Whether it contains a non-identity \code{\verb~|whnf~} at the positions of T4, or containers whose instantiation exercises T3, is inferred from the exporter and kernel code, not observed. That exports contain \code{\verb~|partial~} definitions is inferred from the exporter's filter plus a count of partial constants in a live Lean 4.33 environment (\code{\verb~|work/agent03-decl/Probe3.lean~}).}
\li{The level-simplification and annotation claims were observed on Lean 4.33.0 output, read in v4.36.0 code.}
\li{"The official checker ignores \code{\verb~|numIndices~}/\code{\verb~|isRec~}/..." is from \code{\verb~|Replay.lean~}; the arena's pinned \code{\verb~|official~} checker is v4.35.0 (per 02 §0, same kernel); its \code{\verb~|Replay.lean~} was not diffed against v4.36.0.}
\li{Exit codes of \code{\verb~|leanchecker~} on parse failures (uncaught \code{\verb~|IO~} exception) were not observed by running it.}
\li{\code{\verb~|lean4-leanexport~} and \code{\verb~|lean4-replay~} are sparse clones of the same tag; \code{\verb~|Init/Prelude.lean~} was read only for the declarations named in section 8.}
\li{PR numbers are quoted from source comments, test descriptions and \code{\verb~|lean4lean/divergences.md~}.}
}
}
