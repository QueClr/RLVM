\title{Basic macros}

\p{Shared macros. Every tree that uses a table, a link to a file of the RLVM repository (\code{src} for the file on branch \code{dev}, \code{srcat} for the file as of a commit) or a link to a commit imports this tree with \code{\verb~|\import{base-macros}~}.}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\table[body]{\<html:table>{\body}}
\def\tr[body]{\<html:tr>{\body}}
\def\td[body]{\<html:td>{\body}}
\def\th[body]{\<html:th>{\body}}

\def\src[path]{\<html:a>[href]{https://github.com/QueClr/RLVM/blob/dev/\path}{\code{\path}}}
\def\srcat[hash][path]{\<html:a>[href]{https://github.com/QueClr/RLVM/blob/\hash\verb~|/~\path}{\code{\path}}}
\def\commit[hash]{\<html:a>[href]{https://github.com/QueClr/RLVM/commit/\hash}{\code{\hash}}}
