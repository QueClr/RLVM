\tr{\td{Cost table restated with the spike's numbers (probe, elaboration, match mode, worklist, compiled roots); the 8-10\% worklist estimate and the 80-instruction elaboration estimate withdrawn}\td{0.3, 0.4, 3.1, 3.4}\td{C2.1, C2.2, C2.8, C1.10}}
\tr{\td{Judgment-specialised roles primary: \code{\verb~|TELE~}, \code{\verb~|CONG(c)~} as a per-position plan, \code{\verb~|RULES~} (K1 case trees, K2 derivation); T2 an experiment with a go/no-go number and no claim on K0/K1}\td{0.2, 0.5, 3.2, 3.6, 6.1, 8.1, 8.4, 8.5}\td{C1.10, C2.7, C2.11, C1.15}}
