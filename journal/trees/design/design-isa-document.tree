\tr{\td{\code{\verb~|FAILED~} only for comparisons that completed with \code{\verb~|F~}; \code{\verb~|U~} goes to \code{\verb~|UNDEC~}; \code{\verb~|NEG~} not read under \code{\verb~|ER~}}\td{1.5, 4.4.1, 4.4.2, 5.4, 6.3}\td{C1.9, C3.14 (2, 3)}}
