\tr{\td{Cedar slice}\td{1.75 M}\td{0.03 M (1.7 \%)}\td{0.46 M}\td{1.29 M}\td{1.46 M}\td{0.87 M}\td{0.36 M (41 \%)}}
\tr{\td{Init}\td{4.29 M}\td{0.24 M (5.7 \%)}\td{0.85 M}\td{1.36 M}\td{9.88 M}\td{6.48 M}\td{1.81 M (28 \%)}}
