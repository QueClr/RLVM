\tr{\td{mathlib}\td{8}\td{\code{\verb~|jvm-g1-2-max-13g~}}\td{989.0}\td{214.4}\td{13.24 GB}\td{6,343 G}\td{37 / 0 (+26); 680 ms}\td{1}\td{166}}
\tr{\td{mathlib}\td{8}\td{\code{\verb~|jvm-parallel-2-max-13g~}}\td{1058.6}\td{320.8}\td{13.02 GB}\td{6,405 G}\td{155 / 4; 10.4 s}\td{1}\td{134}}
\tr{\td{mathlib}\td{8}\td{\code{\verb~|native-max-10g~}}\td{1168.2}\td{291.1}\td{7.93 GB}\td{9,030 G}\td{n.r.}\td{1}\td{112}}
