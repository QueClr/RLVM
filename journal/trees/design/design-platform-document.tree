\tr{\td{jvm, reference}\td{cedar}\td{plain (scan-threads=0)}\td{3.27 (3.10) / 4.08 / 24.0}\td{-}\td{-}}
\tr{\td{native, reference}\td{init}\td{2 scanner threads}\td{2.25 (2.25) / 2.29 / 14.7}\td{2.42 (2.38) / 2.38 / 14.6}\td{3.70 (3.69) / 3.74 / 14.3}}
\tr{\td{native, reference}\td{std}\td{2 scanner threads}\td{3.76 (3.75) / 3.82 / 24.9}\td{4.00 (4.00) / 4.10 / 24.9}\td{6.12 (6.11) / 6.15 / 24.3}}
\tr{\td{native, reference}\td{cedar}\td{2 scanner threads}\td{4.88 (4.87) / 4.96 / 32.5}\td{5.18 (5.10) / 5.21 / 32.4}\td{7.93 (7.89) / 7.89 / 31.8}}
\tr{\td{native, reference}\td{mathlib}\td{2 scanner threads}\td{91.76 (91.76) / 92.00 / 619.7}\td{-}\td{-}}
