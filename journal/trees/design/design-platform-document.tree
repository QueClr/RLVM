\subtree{
\title{4. JVM: the collector}

% <!-- BEGIN legend:gc -->
\ul{
\li{\code{\verb~|jvm-c2~}: C2 host JIT, 2 compiler threads (= launcher default, spelled out) - \code{\verb~|-XX:+UseSerialGC -XX:-UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-parallel-2~}: Parallel GC capped at 2 collector threads - \code{\verb~|-XX:+UseParallelGC -XX:ParallelGCThreads=2 -XX:-UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-g1-2~}: G1 capped at 2 parallel + 1 concurrent collector threads - \code{\verb~|-XX:+UseG1GC -XX:ParallelGCThreads=2 -XX:ConcGCThreads=1 -XX:-UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-parallel-auto~}: Parallel GC, HotSpot's own thread count (8 on 8 vCPUs) - \code{\verb~|-XX:+UseParallelGC -XX:-UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-g1-auto~}: G1, HotSpot's own thread counts (8 + 2 on 8 vCPUs) - \code{\verb~|-XX:+UseG1GC -XX:-UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
}
