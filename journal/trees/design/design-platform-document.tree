\tr{\td{jvm, machine}\td{init}\td{plain (scan-threads=0)}\td{0.70 (0.65) / 2.96 / 4.6}\td{0.71 (0.67) / 2.85 / 4.6}\td{-}}
\tr{\td{jvm, machine}\td{std}\td{2 scanner threads}\td{1.17 (1.10) / 3.57 / 8.6}\td{1.16 (1.15) / 3.52 / 8.4}\td{-}}
\tr{\td{jvm, machine}\td{std}\td{plain (scan-threads=0)}\td{1.27 (1.17) / 3.71 / 8.5}\td{1.17 (1.15) / 3.89 / 8.3}\td{-}}
\tr{\td{jvm, machine}\td{cedar}\td{2 scanner threads}\td{1.60 (1.53) / 4.13 / 11.7}\td{1.75 (1.61) / 4.27 / 11.5}\td{-}}
\tr{\td{jvm, machine}\td{cedar}\td{plain (scan-threads=0)}\td{1.58 (1.54) / 4.58 / 11.2}\td{1.56 (1.51) / 4.43 / 11.0}\td{-}}
\tr{\td{jvm, machine}\td{mathlib}\td{2 scanner threads}\td{21.23 (21.23) / 24.31 / 161.4}\td{21.11 (21.11) / 24.34 / 151.7}\td{-}}
\tr{\td{jvm, reference}\td{init}\td{2 scanner threads}\td{1.55 (1.51) / 2.37 / 11.1}\td{1.62 (1.57) / 2.31 / 10.9}\td{-}}
\tr{\td{jvm, reference}\td{init}\td{plain (scan-threads=0)}\td{1.60 (1.54) / 2.19 / 11.8}\td{-}\td{-}}
\tr{\td{jvm, reference}\td{std}\td{2 scanner threads}\td{2.64 (2.61) / 3.33 / 19.1}\td{2.73 (2.72) / 3.47 / 18.3}\td{-}}
