\subtree{
\title{3. JVM: the host JIT}

% <!-- BEGIN legend:jit+jit-1w -->
\ul{
\li{\code{\verb~|jvm-c2~}: C2 host JIT, 2 compiler threads (= launcher default, spelled out) - \code{\verb~|-XX:+UseSerialGC -XX:-UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-graal~}: Graal (libgraal) host JIT, 2 compiler threads - \code{\verb~|-XX:+UseSerialGC -XX:+UseJVMCICompiler -XX:CICompilerCount=2 -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-c2-auto~}: C2 host JIT, HotSpot's own compiler thread count - \code{\verb~|-XX:+UseSerialGC -XX:-UseJVMCICompiler -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-graal-auto~}: Graal host JIT, HotSpot's own compiler thread count - \code{\verb~|-XX:+UseSerialGC -XX:+UseJVMCICompiler -Xms13g -Xmx13g -Xmn1g~}}
\li{\code{\verb~|jvm-c1~}: C1 only (no optimising host JIT) - \code{\verb~|-XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xms13g -Xmx13g -Xmn1g~}}
}
% <!-- END legend:jit+jit-1w -->

