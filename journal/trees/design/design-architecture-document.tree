\tr{\td{L1 loader}\td{\code{\verb~|rlvm-load~}: \code{\verb~|Loader~} (batch), reports, exceptions; \code{\verb~|Loader implements rlvm.export.ExportSink~}}\td{A1-A3, \code{\verb~|rlvm-export~}}\td{A3, R01 2-3}\td{230 files + Init + Std load with exact record counts; catalogue of A3.4; M1 loader criterion}}
\tr{\td{L2 pipeline}\td{\code{\verb~|rlvm-load~}: pipelined publication, level snapshots, late names, forward-reference bookkeeping; loader performance}\td{L1, \code{\verb~|rlvm-level~} snapshot}\td{A3.5-3.6, A4.2, R11 C.6}\td{identical store in batch and pipelined mode; <= 8 instr/byte on mathlib; a reader thread never observes an unpublished datum (stress test)}}
