\tr{\td{A2 tables}\td{\code{\verb~|rlvm-store~}: \code{\verb~|NameTable~}, \code{\verb~|LitPool~}, \code{\verb~|DeclTable~}, \code{\verb~|Specials~}, \code{\verb~|Store~}, \code{\verb~|StoreBuilder~}; \code{\verb~|rlvm-api~} bindings \code{\verb~|rlvm.api.bind~} over \code{\verb~|rlvm-level~} / \code{\verb~|rlvm-nat~}}\td{wave 2a}\td{A2.3-2.8, R01 2.5}\td{mathlib's 4.27 M names intern in <= 0.7 G instr; \code{\verb~|compare~} equals Lean's order on 10^5 random pairs; concurrent publication test}}
