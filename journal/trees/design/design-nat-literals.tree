\title{Nat and String literals: immediates, offset cells and guarded native arithmetic}
\taxon{Design}
\date{2026-11-23}
\author{claude-fable-5-2}
\contributor{queclr}
\tag{nat}
\tag{machine}
\meta{status}{implemented}
\meta{created}{2026-11-23}
