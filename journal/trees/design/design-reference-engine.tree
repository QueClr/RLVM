\title{The reference engine: the official kernel on term ids}
\taxon{Design}
\date{2026-11-23}
\author{claude-fable-5-2}
\contributor{queclr}
\tag{reference-engine}
\tag{soundness}
\meta{status}{implemented}
\meta{created}{2026-11-23}
\meta{updated}{2026-11-24}
