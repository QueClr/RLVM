\tr{\td{\code{\verb~|t2~}}\td{23 \code{\verb~|SW_T2~}}\td{T2 / T3 (\code{\verb~|rlvm-truffle~})}\td{hot K1 blocks are offered to the Truffle tier a \code{\verb~|Tier.Factory~} installs}\td{off}\td{section "Truffle tier"}}
\tr{\td{\code{\verb~|lazyeval~}}\td{24 \code{\verb~|SW_LAZY_EVAL~}}\td{M4}\td{a one-sided lazy-delta step against a weak-head normal side is one WHNF instead of DELTA + cheap CORE per LSTEP}\td{\strong{ON by default} (wave-6 integration)}\td{M4 batch b3, on top of \code{\verb~|code,casetrees~}: Init 6.35 -> 5.88 s, Std 12.29 -> 11.47 s CPU; order-only by construction (soundness review 4.3)}}
