\title{Switches \code{\verb~|pchk~}, \code{\verb~|match~} and \code{\verb~|joint~} in inference}
\taxon{Change}
\date{2026-11-24}
\author{claude-fable-5-2}
\contributor{queclr}
\tag{changelog}
