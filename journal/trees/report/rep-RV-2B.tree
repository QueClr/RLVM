\tr{\td{g6, depth}\td{2 to 70 alias lets, 2 to 70 lambda-body lets, 70 dummy lets around one}\td{448}\td{196 / 252}\td{447}\td{0 / 1}\td{0 / 0}\td{136 (196)}}
