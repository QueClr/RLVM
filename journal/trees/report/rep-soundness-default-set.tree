\tr{\td{manifest in the form of \code{\verb~|rlvm-machine/src/test/resources/s/manifest.tsv~} with one more column: name, OFFICIAL verdict, KIND (\code{\verb~|T~} or \code{\verb~|strict~}), marks, attack}\td{\code{\verb~|work/s3/manifest.tsv~} (\code{\verb~|mkmanifest.py~})}}
\tr{\td{generators (on package S's builder \code{\verb~|tools/lk.py~} and E1's \code{\verb~|common.py~})}\td{\code{\verb~|work/s3/gen/s3lib.py~}, \code{\verb~|batchA.py~} (cache, pair table, sessions, mdata), \code{\verb~|batchC.py~} (reduction routes against the cache), \code{\verb~|batchD.py~} (pchk), \code{\verb~|batchE.py~} (shapes and shortcuts), \code{\verb~|batchF.py~} (rows for the seeded faults), \code{\verb~|batchG.py~} (kind F hunt in the case trees), \code{\verb~|batchK.py~} (k2), \code{\verb~|batchR.py~} (random programs with a Python evaluator), \code{\verb~|batchH.py~} (reductions of S3-F7), \code{\verb~|batchN.py~}, \code{\verb~|batchP.py~} (the candidate: eager, the shortcuts' masks, admission)}}
