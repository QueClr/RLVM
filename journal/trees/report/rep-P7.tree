\tr{\td{}\td{4}\td{5.70 s}\td{4.05 s}\td{4.21 s}\td{3.97 / 4.12 s}\td{4.05}}
\tr{\td{}\td{8}\td{4.29 s}\td{2.59 s}\td{2.78 s}\td{2.41 / 2.14 s}\td{6.34}}
