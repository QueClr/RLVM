\tr{\td{Init}\td{4.08 s}\td{4.12}\td{7.75}\td{6.72}\td{6.22}\td{13.57}}
\tr{\td{Std}\td{7.13}\td{7.57}\td{13.27}\td{}\td{}\td{}}
