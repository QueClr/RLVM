\title{Stepper-convention spike: result tables}
\taxon{Report}
\date{2026-11-24}
\author{claude-fable-5-2}
\contributor{queclr}
\tag{machine}
\tag{performance}
\meta{origin}{spikes/stepper/results/tables.md}
\meta{moved}{2026-11-24}
\import{base-macros}

\p{Generated by \src{spikes/stepper/scripts/tables.py} from \code{\verb~|spikes/stepper/results/*.txt~}; the estimators are described at the head of that script and in \src{spikes/stepper/README.md}. CPU time comes first in every table; every ratio is against R of the same runtime, corpus and workload. Host: aarch64 (Cortex-X925 performance cores), Docker with the arena limits (8 cores, 16 GB).}

\table{
\tr{\th{variant}\th{what it is}}
\tr{\td{R}\td{plain host recursion (the baseline)}}
\tr{\td{Ri}\td{R with inert application nests evaluated by the scratch-buffer loop of W1}}
\tr{\td{W0}\td{ISA 1.3 as written: run() -> X.step(m) -> switch on st, registers in machine fields, header + 5 payload words}}
\tr{\td{W1n}\td{W1 without the inert-nest loop}}
\tr{\td{W1}\td{fused loop per family, W / wp / A in locals, dense dispatch, same-family push = continue, inert nests in one loop}}
\tr{\td{H0}\td{H with D = 0: every non-leaf sub-judgment becomes a frame (the specification mode)}}
\tr{\td{H8}\td{bounded host recursion, D = 8}}
\tr{\td{H32}\td{bounded host recursion, D = 32}}
\tr{\td{H64}\td{bounded host recursion, D = 64}}
\tr{\td{H256}\td{bounded host recursion, D = 256}}
\tr{\td{Hinf}\td{H that never materialises (cost of the resumable form alone)}}
\tr{\td{Hi64}\td{H64 with the inert-nest loop}}
\tr{\td{HT64}\td{H64 charging one tick per judgment (budgets, TRY)}}
}

