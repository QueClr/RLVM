\tr{\td{one load: user cycles, G}\td{1.900 -> 1.627 (0.856)}\td{15.48 -> 13.16 (0.850)}\td{not counted}\td{36.99 -> 32.66 (0.883)}}
\tr{\td{one load: kernel cycles, G}\td{0.265 -> 0.251}\td{1.754 -> 1.760}\td{not counted}\td{4.367 -> 4.273}}
