\tr{\td{comparisons past the tables}\td{36.40 M / 31.91 M = 1.14}\td{11.74 M / 8.01 M = 1.47}\td{12.74 M / 12.77 M = 1.00}}
\tr{\td{whnf past its memo}\td{14.65 M / 8.09 M = 1.81}\td{2.99 M / 1.31 M = 2.29}\td{6.28 M / 2.81 M = 2.23}}
