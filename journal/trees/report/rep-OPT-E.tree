\tr{\th{event (RLVM / gruszka = ratio)}\th{Mathlib}\th{navier-stokes-euler}\th{cslib}}
\tr{\td{ticks (two different instruments)}\td{574.10 M / 495.49 M = 1.16}\td{144.22 M / 130.58 M = 1.10}\td{215.96 M / 187.99 M = 1.15}}
