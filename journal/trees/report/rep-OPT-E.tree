\tr{\td{unfoldings through a body: DELTA calls / gruszka's without the direct ones}\td{24.57 M / 18.56 M = 1.32}\td{6.22 M / 3.35 M = 1.86}\td{9.29 M / 6.41 M = 1.45}}
\tr{\td{unfoldings asked for (done + memo hits)}\td{31.28 M / 27.61 M = 1.13}\td{8.71 M / 4.95 M = 1.76}\td{11.29 M / 9.03 M = 1.25}}
