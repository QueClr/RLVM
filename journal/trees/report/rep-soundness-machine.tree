\tr{\td{pass B, quick refutation, UNDEC, FAILED, debt (\code{\verb~|probes~})}\td{order-only: every answer is an answer of the complete CONV on a pair; U never enters FAILED; a fatal fault is never turned into U}\td{\code{\verb~|Cargs.passB~}, \code{\verb~|Frames.k_try~}}\td{code review; matrix of section 5}}
\tr{\td{TRY segments}\td{a cut restores scopes, scratch, environment, registers, ER; memos are written only by completing steps; a capped budget passes ABORT on}\td{\code{\verb~|Frames.k_try~}, \code{\verb~|trySignalSlow~}}\td{code review (no export reaches a cut deliberately)}}
\tr{\td{eta, structure eta, unit-like, K, structure eta in iota}\td{the official side conditions: Pi type after whnf; \code{\verb~|is_non_rec_structure~} (recomputed flags); no eta for propositions; K only when the type of the major converts with the constructor's}\td{\code{\verb~|Conv.eta~}, \code{\verb~|etas~}, \code{\verb~|unitl~}, \code{\verb~|isNonRecStructure~}; \code{\verb~|Reduce~}}\td{\code{\verb~|eta-*~} (9, of them 6 structure eta, incl. a forged \code{\verb~|isRec~} flag), \code{\verb~|unitlike-*~} (6), \code{\verb~|iota-struct-*~} (3), \code{\verb~|k-eq-rec-*~} (4), \code{\verb~|krule-*~} (4)}}
\tr{\td{lazy delta, Nat fold and offsets, \code{\verb~|Bool.true~} shortcut}\td{the official order; fold only when both sides are closed or ER; OPEN is the official \code{\verb~|has_fvar~} (let variables of INFER included, erratum E1)}\td{\code{\verb~|Conv.lazydLoop~}, \code{\verb~|lazydFold~}}\td{\code{\verb~|nat-*~} (117), \code{\verb~|k1-*~} (43), \code{\verb~|open-flag-*~} (3: a variable that beta discards, a let variable)}}
\tr{\td{\code{\verb~|lazyeval~} (one-sided unfolding by one WHNF)}\td{the other side is weak-head normal, so the official loop can only leave early through its success cache; the final pair is the same}\td{\code{\verb~|Conv.lstep~} (M4)}\td{argument: quick refutes only WHNF forms, OFFSET needs constructor / literal forms, fold is what WHNF does; matrix of section 5}}
}
}

