\tr{\td{F2}\td{3}\td{the unread position with one argument and with the pair in the last position (accepts); the pair in the first position (reject, kind T)}}
\tr{\td{F3, F4}\td{3}\td{the proof position behind two definitions, alone and after a plain declaration; the two K recursors}}
\tr{\td{F5}\td{3}\td{32 nested redexes (accept), 24 (accept), 32 under the flag alone (reject, kind T)}}
