\tr{\th{collector}\th{mac Init, 1 w}\th{mac Init, 8 w}\th{mac Std, 1 w}\th{mac Std, 8 w}\th{mac mathlib, 8 w}\th{ref Init, 1 w}\th{ref Init, 8 w}\th{ref Std, 1 w}\th{ref Std, 8 w}\th{ref mathlib, 8 w}}
