\table{
\tr{\th{Gate}\th{Switch set}\th{Corpora}\th{Engine checks}\th{SOUNDNESS}\th{COMPLETENESS}\th{Tier / convention (D0, unbounded) / audit differences}\th{Pipeline verdicts}\th{Result}}
