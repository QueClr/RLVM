\tr{\td{machine, plain default set}\td{Oracle PGO Bd (Init, trained with the plain default set)}\td{2,544.9 G}\td{-9.3 \%}\td{}\td{192.8 G}\td{-12.1 \%}\td{}\td{75.4 G}\td{-11.2 \%}\td{}}
\tr{\td{machine, plain default set}\td{Oracle PGO B (Init)}\td{2,511.7 G}\td{-10.5 \%}\td{-1.3 \%}\td{188.5 G}\td{-14.1 \%}\td{-2.3 \%}\td{73.8 G}\td{-13.2 \%}\td{-2.2 \%}}
\tr{\td{machine, plain default set}\td{Oracle PGO S2 (STALE: Init, profile of the jars of 19:41Z)}\td{2,618.0 G}\td{-6.7 \%}\td{+2.9 \%}\td{207.1 G}\td{-5.6 \%}\td{+7.4 \%}\td{78.9 G}\td{-7.2 \%}\td{+4.6 \%}}
\tr{\td{reference engine}\td{CE image (as shipped)}\td{8,560.8 G}\td{}\td{}\td{533.2 G}\td{}\td{}\td{251.8 G}\td{}\td{}}
