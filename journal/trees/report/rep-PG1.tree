\tr{\td{machine, candidate set}\td{Oracle PGO S2 (STALE: Init, profile of the jars of 19:41Z)}\td{1,618.9 G}\td{-4.1 \%}\td{+9.1 \%}\td{195.4 G}\td{-4.3 \%}\td{+11.9 \%}\td{76.4 G}\td{-5.9 \%}\td{+8.6 \%}}
\tr{\td{machine, plain default set}\td{CE image (as shipped)}\td{2,806.0 G}\td{}\td{}\td{219.3 G}\td{}\td{}\td{85.0 G}\td{}\td{}}
