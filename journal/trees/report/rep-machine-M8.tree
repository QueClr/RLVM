\tr{\td{tutorial, through the launcher (09:06Z)}\td{\strong{PASSED} 141 / 141: verdicts right, \code{\verb~|machine.declined == 0~}, \code{\verb~|units.declined == 0~}}\td{\code{\verb~|machine-launcher-tutorial.txt~}}}
\tr{\td{\code{\verb~|bugs/~} (34 files), in-process / launcher (09:04Z)}\td{\strong{DIFF-CLEAN} (1136 accepted + 11 rejected) / \strong{PASSED} 34 / 34}\td{\code{\verb~|machine-diff-bugs.txt~}, \code{\verb~|machine-launcher-bugs.txt~}}}
