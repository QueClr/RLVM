\tr{\td{machine, 4 workers}\td{all eight}\td{457.3 M}\td{55.2 M}\td{703}\td{3,234}\td{0}}
\tr{\td{machine, 1 worker, batch load}\td{Init, Std, cedar, reachability, con-leche}\td{47.0 M}\td{2.3 M}\td{0}\td{449}\td{0}}
\tr{\td{machine, 1 worker, pipelined}\td{Init, Std, cedar}\td{39.2 M}\td{2.1 M}\td{84}\td{279}\td{0}}
\tr{\td{machine, 8 workers, a publication per 4,096 units and 32 MiB whatever the size of the file}\td{Std, cedar, cslib, navier-stokes-euler}\td{180.4 M}\td{20.7 M}\td{711}\td{1,044}\td{0}}
\tr{\td{machine, 8 workers, a publication every 64 units}\td{Init, Std, reachability}\td{21.9 M}\td{1.2 M}\td{1,391}\td{1,131}\td{0}}
\tr{\td{machine, 8 workers, the driver's session cap at 1 MiB}\td{Init, Std, cedar, cslib}\td{138.5 M}\td{14.8 M}\td{938}\td{9,428}\td{0}}
