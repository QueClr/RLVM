\tr{\th{Export}\th{units}\th{accepted by the machine}\th{declined}\th{T answers of a shortcut that were re-derived (\code{\verb~|audits~})}\th{not found by the complete procedure (\code{\verb~|E_AUDIT~})}\th{re-derivation out of budget (inconclusive)}\th{B1 T}\th{B3 plans}\th{B4 plans}\th{B12 T}}
\tr{\td{\code{\verb~|init-prelude~} (arena test)}\td{1,710}\td{1,710}\td{0}\td{324}\td{\strong{0}}\td{0}\td{139}\td{124}\td{67}\td{3}}
\tr{\td{\code{\verb~|Mathlib.Algebra.Group.Basic.cone~}}\td{1,724}\td{1,720}\td{4}\td{5,204}\td{\strong{0}}\td{2}\td{2,880}\td{133}\td{2,185}\td{16}}
\tr{\td{\code{\verb~|Mathlib.Data.Nat.Basic.cone~}}\td{2,711}\td{2,701}\td{10}\td{5,656}\td{\strong{0}}\td{14}\td{3,706}\td{200}\td{1,501}\td{271}}
\tr{\td{\code{\verb~|Mathlib.Topology.Basic.cone~}}\td{3,318}\td{3,316}\td{2}\td{6,371}\td{\strong{0}}\td{23}\td{3,530}\td{692}\td{2,025}\td{276}}
\tr{\td{\code{\verb~|Mathlib.Data.Fintype.Basic.cone~}}\td{4,520}\td{4,492}\td{28}\td{10,033}\td{\strong{0}}\td{41}\td{5,917}\td{1,128}\td{2,821}\td{366}}
\tr{\td{\code{\verb~|Mathlib.Data.List.Basic.cone~}}\td{4,278}\td{4,204}\td{74}\td{10,460}\td{\strong{0}}\td{23}\td{6,307}\td{1,069}\td{2,745}\td{458}}
\tr{\td{\code{\verb~|Mathlib.Order.Basic.cone~}}\td{7,663}\td{7,655}\td{8}\td{64,058}\td{\strong{0}}\td{574}\td{44,339}\td{1,705}\td{18,321}\td{380}}
\tr{\td{\code{\verb~|Mathlib.GroupTheory.Sylow.cone~}}\td{13,663}\td{13,619}\td{44}\td{70,112}\td{\strong{0}}\td{1,072}\td{41,396}\td{4,508}\td{25,001}\td{638}}
