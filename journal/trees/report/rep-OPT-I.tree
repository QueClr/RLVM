\tr{\td{Std, nothing kept between declarations}\td{79,290,688}\td{75,942,991}\td{-3,347,697 (-4.22 \%)}\td{8,661}\td{3,347,697 (4.22 \%)}\td{+0 in 2 units}\td{0}\td{2, 2}\td{1, 1}}
