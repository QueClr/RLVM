\tr{\td{cslib, default (warm sessions)}\td{215,956,521}\td{212,335,111}\td{-3,621,410 (-1.68 \%)}\td{30,445}\td{4,131,989 (1.91 \%)}\td{+510,579 in 95,356 units}\td{0}\td{14, 14}\td{7, 7}}
