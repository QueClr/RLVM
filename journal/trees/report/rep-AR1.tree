\tr{\td{1}\td{the machine becomes the default engine (provider priority >= 100; today 10)}\td{(b)}\td{\strong{-5,448.6 G} (-64.7 \%)}\td{measured}\td{2,978.5 G}\td{\strong{8}}}
\tr{\td{2}\td{INT6's candidate switch set instead of \code{\verb~|warm,gated,expect~}}\td{(c*)}\td{-230.8 G (-7.7 \%) against (b)}\td{measured}\td{2,747.7 G}\td{8 (7 if RLVM's ratio is 0.97 or more)}}
