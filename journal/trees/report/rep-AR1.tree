\tr{\td{6}\td{loader at the leaders' cost}\td{load 133.2 G = 21 instructions per byte; leaders 37 - 41 G = 6 per byte}\td{up to -93 G}\td{measured bound}\td{-}\td{no place by itself}}
\tr{\td{7}\td{admission (environment pass)}\td{25.1 G; inductive types cost the leaders under 3 G}\td{up to -22 G}\td{measured bound}\td{-}\td{none}}
\tr{\td{8}\td{garbage collection}\td{0.6 G in (b), 8.7 G in (a): 0.0 \% and 0.1 \%}\td{0}\td{measured (profile)}\td{-}\td{none}}
