\p{Commands:}

\pre{\verb~|
work/prof/X5/build.sh
CP=$(cat work/prof/X5/classes/classpath.txt)
java -cp $CP rlvm.load.tools.X5Tool run  work/exports/init.ndjson --repeat 4 --threads 1,8 --rounds 3
java -cp $CP rlvm.load.tools.X5Tool diff work/arena-site/tests work/mutants/suite        # eager against lazy, per file
java -cp $CP rlvm.load.tools.X5Tool explain FILE CID                                       # first differing node of a constant
bench/quiet.py -- work/prof/X5/measure.sh cedar 4g
~}
}
