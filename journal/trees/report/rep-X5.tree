\tr{\th{}\th{Init}\th{Std}\th{cedar}\th{mathlib}}
\tr{\td{eager: load + decode (8 workers)}\td{0.519 + 0.159 = 0.677 s}\td{0.929 + 0.230 = 1.159 s}\td{1.429 + 0.313 = 1.742 s}\td{10.637 + 2.653 = 13.290 s}}
