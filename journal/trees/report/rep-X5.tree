\tr{\td{proof blocks (records), eager -> lazy}\td{37,601 (5,071,212) -> 154 (939)}\td{64,517 (7,808,271) -> 267 (1,528)}\td{73,306 (11,352,348) -> 955 (6,485)}\td{475,132 (78,207,172) -> 2,013 (15,204)}}
