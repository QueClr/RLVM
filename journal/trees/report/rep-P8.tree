\title{5. Owners, exactness, prize (summary)}

\table{
\tr{\th{\verb~|#~}\th{mechanism}\th{prize on Mathlib (machine's checking instructions)}\th{official-exact?}\th{owner}}
\tr{\td{1}\td{proof arguments of one head and proof fields of structure eta are not compared (B3, ETAS mask; B4 unread positions)}\td{31.4 \% alone (42 \% of the ticks)}\td{no: S-F2, D27; sound by the theory, what both leaders do}\td{M4 (Conv, Cargs), M5 (Facts)}}
