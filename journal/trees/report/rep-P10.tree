\tr{\td{structure eta of a major premise on the stack}\td{0.07 \%}\td{0.11}\td{0.01}\td{hc 45 \%, eval 16 \%, memo 16 \%, store 16 \%, code 2 \%, infer 2 \%, level 2 \%}}
\tr{\td{lambda eta on the stack}\td{1.00 \%}\td{1.48}\td{0.18}\td{hc 34 \%, memo 20 \%, eval 13 \%, code 6 \%, conv 6 \%, level 6 \%, store 6 \%}}
\tr{\td{structure eta / unit-like (conversion) on the stack}\td{0.98 \%}\td{1.45}\td{0.18}\td{hc 33 \%, memo 19 \%, eval 13 \%, conv 7 \%, code 6 \%, store 6 \%, level 6 \%}}
\tr{\td{a code block running on the stack}\td{14.95 \%}\td{22.18}\td{2.77}\td{hc 42 \%, memo 23 \%, code 23 \%, level 10 \%, store 1 \%, session 1 \%, eval 1 \%}}
\tr{\td{Nat folding on the stack}\td{0.17 \%}\td{0.25}\td{0.03}\td{hc 36 \%, code 20 \%, memo 15 \%, reduce 7 \%, store 7 \%, level 7 \%, num 4 \%}}
