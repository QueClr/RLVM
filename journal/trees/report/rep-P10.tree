\subtree{
\title{2.3 Judgments in progress: proof irrelevance, the K rule, structure eta (inclusive)}

\p{The machine calls its sub-judgments on the host stack down to depth 128, so a sample's Java stack names the judgments in progress. A sample counts in every line it is under; 5.6 \% of the samples are continuation steps resumed from the machine's own stack, whose callers are not visible (the inclusive numbers are lower bounds by at most that).}

\table{
\tr{\th{inclusive: samples with ..}\th{share of worker samples}\th{CPU s}\th{wall s}\th{made of (innermost item group)}}
\tr{\td{the machine as a whole (\code{\verb~|MachineSession.check~} on the stack)}\td{84.19 \%}\td{124.87}\td{15.61}\td{hc 33 \%, memo 13 \%, eval 13 \%, store 10 \%, infer 9 \%, level 9 \%, conv 5 \%}}
\tr{\td{INFER on the stack}\td{74.56 \%}\td{110.59}\td{13.82}\td{hc 32 \%, eval 13 \%, memo 13 \%, store 11 \%, infer 10 \%, level 9 \%, conv 5 \%}}
\tr{\td{CHECK on the stack}\td{63.64 \%}\td{94.39}\td{11.80}\td{hc 33 \%, memo 14 \%, eval 13 \%, store 10 \%, infer 9 \%, level 8 \%, conv 6 \%}}
\tr{\td{CONV on the stack}\td{51.92 \%}\td{77.01}\td{9.63}\td{hc 34 \%, memo 19 \%, eval 11 \%, conv 8 \%, code 7 \%, level 7 \%, store 7 \%}}
\tr{\td{lazy delta reduction on the stack}\td{33.20 \%}\td{49.24}\td{6.15}\td{hc 38 \%, memo 19 \%, eval 10 \%, code 9 \%, conv 7 \%, level 5 \%, store 5 \%}}
\tr{\td{comparison of application arguments (CARGS) on the stack}\td{47.54 \%}\td{70.52}\td{8.81}\td{hc 35 \%, memo 19 \%, eval 11 \%, conv 8 \%, code 7 \%, store 6 \%, level 6 \%}}
\tr{\td{PROOF IRRELEVANCE (\code{\verb~|Conv.pirr~} .. \code{\verb~|k_pirr3~}) on the stack: the rule and everything it triggers}\td{27.51 \%}\td{40.80}\td{5.10}\td{hc 41 \%, memo 14 \%, eval 13 \%, level 6 \%, conv 6 \%, code 6 \%, store 5 \%}}
\tr{\td{VTYPE (type of a value) on the stack}\td{9.73 \%}\td{14.43}\td{1.80}\td{hc 37 \%, eval 22 \%, infer 15 \%, level 11 \%, store 8 \%, memo 6 \%, code 0 \%}}
\tr{\td{WHNF on the stack}\td{15.41 \%}\td{22.86}\td{2.86}\td{hc 34 \%, memo 26 \%, code 13 \%, level 11 \%, eval 7 \%, reduce 6 \%, store 4 \%}}
\tr{\td{delta on the stack}\td{17.21 \%}\td{25.53}\td{3.19}\td{hc 40 \%, memo 25 \%, code 15 \%, level 9 \%, reduce 5 \%, eval 4 \%, store 3 \%}}
\tr{\td{iota on the stack}\td{0.86 \%}\td{1.28}\td{0.16}\td{hc 33 \%, memo 14 \%, store 14 \%, code 12 \%, eval 9 \%, reduce 9 \%, level 7 \%}}
