\tr{\td{Default configuration, the jars (\code{\verb~|gate.sh --defaults --corpus all --hostile~})}\td{\code{rlvm-jvm}, no option}\td{PASS: 230 / 230; 17,775 mutants SOUNDNESS 0, COMPLETENESS 0, agree 15,741, declined 2,034, no error and no timeout; self-test of the differential path caught; hostile 1,196: agree 1,124, tolerated 68, wrong accept 0, wrong reject 0, declined 4}}
\tr{\td{The reference engine by name (\code{\verb~|gate.sh --corpus all --hostile~})}\td{\code{rlvm-jvm}, \code{\verb~|-X engine=reference~}, batch load, one worker}\td{PASS: 230 / 230; 17,775 mutants SOUNDNESS 0, COMPLETENESS 0, agree 15,741, declined 2,034, no error; self-test caught; hostile 1,196: agree 1,182, tolerated 6, wrong accept 0, wrong reject 0, declined 8}}
\tr{\td{The strict policy (\code{\verb~|gate.sh --corpus bugs --hostile -X policy=strict~})}\td{\code{rlvm-jvm}, \code{\verb~|-X policy=strict~}, batch load, one worker}\td{PASS: 230 / 230; 2,692 mutants of the corpus \code{bugs} SOUNDNESS 0, COMPLETENESS 0, agree 2,579, declined 113, no error; self-test caught; hostile 1,196: agree 1,177, tolerated 0, wrong accept 0, wrong reject 0, declined 19}}
\tr{\td{The eight corpora, 8 and 4 workers}\td{\code{rlvm} and \code{rlvm-jvm}, no option but \code{\verb~|--threads~}}\td{32 of 32 runs ACCEPT, exit status 0}}
\tr{\td{The eight corpora under the strict policy, 8 workers}\td{\code{rlvm} and \code{rlvm-jvm}, \code{\verb~|-X policy=strict~}}\td{16 of 16 runs ACCEPT, every unit accepted, 0 declined (Mathlib: 721,845 of 721,845 units)}}
\tr{\td{Cost only: the counters of a deterministic run, baseline against merged build}\td{\code{rlvm} and \code{rlvm-jvm}, one worker, batch load}\td{177 to 182 counters per corpus compared on each launcher, 0 different (table below)}}
