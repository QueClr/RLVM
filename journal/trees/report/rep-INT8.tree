\tr{\td{navier-stokes-euler}\td{24.41}\td{22.67}\td{0.25}\td{0.22}\td{266,379}\td{230,561}\td{2.44}\td{2.00}\td{181,041}\td{174,697}\td{51}\td{37}\td{8.0}\td{7.0}}
