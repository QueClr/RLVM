\tr{\td{gruszka: CPU s (median of the second runs) / peak resident set, MiB}\td{63.8 / 2,868}\td{15.6 / 943}\td{22.9 / 1,496}}
\tr{\td{the executable before the wave, warm pass: wall s / CPU s}\td{14.57 / 110.4}\td{3.89 / 29.1}\td{5.28 / 39.1}}
\tr{\td{\strong{the merged executable}, warm pass: wall s / CPU s}\td{\strong{13.11} / 101.5}\td{\strong{3.49} / 26.7}\td{\strong{4.82} / 36.5}}
